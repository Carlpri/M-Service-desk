DATABASE_URL=postgresql://postgres:postgres@localhost:5432/m_service_desk?schema=public
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173

# Configure both values together to enable email verification and password-reset emails.
# RESEND_API_KEY is obtained from https://resend.com/api-keys
# EMAIL_FROM must come from a domain verified in the Resend dashboard.
# For testing you can use: onboarding@resend.dev (delivers to your own address only)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# Cloudinary image upload configuration
# Obtain these from your Cloudinary Dashboard: https://console.cloudinary.com/
# Either provide individual credentials:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Or provide the full connection URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
