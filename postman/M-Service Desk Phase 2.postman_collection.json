{
  "info": {
    "_postman_id": "c23298a5-84b8-4fb1-9ab3-9a89aec202e9",
    "name": "M-Service Desk - Phase 2 Authentication",
    "description": "Manual API tests for Phase 2. Import this collection, configure the variables, then run requests individually in the documented order. Email token requests require configured SMTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Availability",
      "item": [
        {
          "name": "API root",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API root is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().application).to.eql('M-Service Desk');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Database-backed health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health response accurately reports database state', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) pm.expect(body.database).to.eql('connected');",
                  "  else pm.expect(body.database).to.eql('disconnected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Registration and email verification",
      "item": [
        {
          "name": "Register citizen (role escalation check)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('userEmail')) {",
                  "  pm.collectionVariables.set('userEmail', `citizen.${Date.now()}@example.com`);",
                  "}",
                  "if (!pm.collectionVariables.get('password')) {",
                  "  pm.collectionVariables.set('password', `Test-only-${Date.now()}-Pass!`);",
                  "}",
                  "if (!pm.collectionVariables.get('newPassword')) {",
                  "  pm.collectionVariables.set('newPassword', `Changed-${Date.now()}-Pass!`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration creates a citizen without returning a hash', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('CITIZEN');",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(body.user).not.to.have.property('passwordHash');",
                  "  pm.collectionVariables.set('registeredUserId', body.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Citizen\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Verify email (paste token from email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email token is accepted once', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid or expired verification token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"deliberately-invalid-verification-token\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid verification token is rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('VERIFICATION_TOKEN_INVALID');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification (generic response)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/resend-verification"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend response does not reveal account existence', function () {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.text()).not.to.include('token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid registration returns structured validation error', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Citizen\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate email returns conflict', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('EMAIL_ALREADY_REGISTERED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Login and protected endpoints",
      "item": [
        {
          "name": "Login (saves accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a bearer token and safe profile', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.user).not.to.have.property('passwordHash');",
                  "  pm.collectionVariables.set('accessToken', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login (saves adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@muranga.go.ke\",\n  \"password\": \"CountyAdmin2026!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login returns admin bearer token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql(\"ADMIN\");",
                  "  pm.collectionVariables.set(\"adminToken\", body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated profile is safe', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const user = pm.response.json().user;",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(user).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject request without a bearer token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token is rejected', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('AUTHENTICATION_REQUIRED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid credentials",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"deliberately incorrect password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Incorrect password gets generic 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Citizen cannot list users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/users?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Citizen receives forbidden response', function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error).to.eql('FORBIDDEN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin can list users (set adminToken)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/users?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin receives paginated safe user list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('users');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revokes accessToken)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout revokes the session', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.collectionVariables.unset('accessToken');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Password management",
      "item": [
        {
          "name": "Change password (invalidates all sessions)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password change succeeds and revokes sessions', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().sessionsInvalidated).to.eql(true);",
                  "  pm.collectionVariables.set('password', pm.collectionVariables.get('newPassword'));",
                  "  pm.collectionVariables.unset('accessToken');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Request password reset (generic response)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset request is generic and returns no token', function () {",
                  "  pm.response.to.have.status(202);",
                  "  pm.expect(pm.response.text()).not.to.include('resetToken');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password (paste token from email)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid reset changes password and invalidates sessions', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().sessionsInvalidated).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid or expired reset token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"deliberately-invalid-reset-token\",\n  \"newPassword\": \"Another-test-only-password!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid reset token is rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('RESET_TOKEN_INVALID');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Service requests",
      "item": [
        {
          "name": "Submit service request (Citizen)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Roads & Infrastructure\",\n  \"location\": \"Kiharu Constituency, Muranga\",\n  \"description\": \"Severe potholes near the market entrance need resurfacing.\",\n  \"imageUrl\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/service-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Service request created successfully\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.request.status).to.eql(\"PENDING\");",
                  "  pm.expect(body.request).to.have.property(\"referenceNumber\");",
                  "  pm.collectionVariables.set(\"requestId\", body.request.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my service requests (Citizen)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns citizen requests list\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"requests\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get service request by ID (Citizen)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns specific request details\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.request.id).to.eql(pm.collectionVariables.get(\"requestId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all service requests (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/service-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin receives all service requests\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"requests\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get analytics overview (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/service-requests/analytics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin receives analytics breakdown\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.analytics).to.have.property(\"totalRequests\");",
                  "  pm.expect(body.analytics).to.have.property(\"statusBreakdown\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update request status to IN_PROGRESS (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"resolutionNote\": \"County road maintenance team dispatched to inspect site.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/service-requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status updated to IN_PROGRESS\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.request.status).to.eql(\"IN_PROGRESS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update request status to RESOLVED (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"resolutionNote\": \"Road resurfacing completed.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/service-requests/{{requestId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status updated to RESOLVED\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.request.status).to.eql(\"RESOLVED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}